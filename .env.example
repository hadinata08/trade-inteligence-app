# Copy to .env and replace every change-me value before starting the stack.
# Inside Docker Compose, services reach each other by service name — never localhost.

DATABASE_URL=postgresql://iti:change-me-db@postgres:5432/indonesia_trade?schema=public
REDIS_URL=redis://:change-me-redis@redis:6379/0

# Free API key from https://comtradedeveloper.un.org/ — server side only.
# Leave empty to run with clearly labelled fixture data. Never commit a real key.
COMTRADE_API_KEY=
COMTRADE_BASE_URL=https://comtradeapi.un.org
COMTRADE_ALLOWED_HOSTS=comtradeapi.un.org
# Operational budget is below the provider cap of 500 calls/day.
# The remaining allowance is kept for manual checks and retries.
COMTRADE_DAILY_REQUEST_BUDGET=450
# Provider ceiling is 1 request/second. 1500ms is the conservative default.
COMTRADE_MIN_REQUEST_INTERVAL_MS=1500
COMTRADE_MAX_RECORDS=100000
# Rolling window. Quota is NOT reset at local (WIB) midnight.
COMTRADE_QUOTA_WINDOW_HOURS=24
COMTRADE_DATA_SOURCE=auto

AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me-admin-password

NEXT_PUBLIC_APP_URL=http://localhost:8080
EXPORT_STORAGE_PATH=/var/lib/iti/exports
LOG_LEVEL=info

POSTGRES_USER=iti
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=indonesia_trade
REDIS_PASSWORD=change-me-redis
HTTP_PORT=8080

# Host-side development only (docker-compose.dev.yml publishes these on localhost).
# Ports avoid 5432 and 6379, which are often already used by other local databases.
# DATABASE_URL=postgresql://iti:change-me-db@127.0.0.1:55432/indonesia_trade?schema=public
# REDIS_URL=redis://:change-me-redis@127.0.0.1:56379/0
# NEXT_PUBLIC_APP_URL=http://localhost:3000
